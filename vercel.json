{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "downloader": {
      "root": "downloader",
      "framework": "flask"
    },
    "kakashii-hub": {
      "root": "kakashii-hub",
      "framework": "tanstack-start"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
